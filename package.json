    "postcss-loader": "^7.0.2",
    "rc-tree": "^5.7.2",
    "react-ace": "^10.1.0",
    "react-big-calendar": "^1.5.2",
    "react-currency-input-field": "^3.6.9",
    "react-datepicker": "^4.8.0",

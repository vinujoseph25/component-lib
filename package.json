{
  "name": "inclue-uicomps",
  "version": "15.0.0-beta.6",
  "description": "inclue resusable UI components",
  "main": "components/index.js",
  "types": "components/index.d.ts",
  "incluecomp": {
    "outDir": "dist",
    "tempStyleFolder": "__scss__",
    "commonStyleImports": [
      "/_colors.scss",
      "/_motifColors.scss",
      "/helpers/responsive.scss"
    ]
  },
  "scripts": {
    "storybook": "cross-env TSC_WATCHFILE=UseFsEventsWithFallbackDynamicPolling storybook dev -p 6006",
    "lint": "eslint \"src/components/**/*.{ts,tsx}\"",
    "test": "start-server-and-test storybook http://localhost:6006 test:cypressopen",
    "test:ci": "run-p --race test:ci:run test:ci:serve",
    "test:ci:run": "run-s build-storybook test:cypressrun",
    "test:ci:serve": "http-server ./storybook-static -p 6006 -s",
    "test:cypressrun": "cypress run --headless --browser chrome",
    "test:cypressopen": "cross-env cypress open --browser electron",
    "clean": "rimraf dist && mkdir dist",
    "copy:styles": "ncp src/styles dist/styles",
    "copy:assets": "ncp src/assets dist/assets",
    "copy:pkg": "ncp ./package.json dist/package.json && ncp ./.npmignore dist/.npmignore && ncp ./.npmrc dist/.npmrc",
    "refreshVSToken": "vsts-npm-auth -config .npmrc",
    "changelog": "git log --pretty='- %s' --first-parent  >> CHANGELOG.md",
    "prepublishOnly": "npm run clean && npm run copy:assets && npm run copy:styles && npm run copy:external && rollup -c",
    "postinstall": "patch-package",
    "build-storybook": "storybook build",
    "build:pkg": "npm run clean && npm run copy:assets && npm run copy:styles && npm run copy:pkg && tsc && node build-script.js && rimraf __scss__",
    "release": "cd dist && npm pack && npm publish *.tgz",
    "src": "lib/codemirror.js"
  },
  "author": "Niranjan Kumar",
  "license": "ISC",
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.4",

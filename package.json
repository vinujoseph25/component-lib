    "npm-run-all": "^4.1.5",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^2.8.1",
    "prettier-loader": "^3.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-scripts": "5.0.1",
    "rimraf": "^3.0.2",
    "sass": "^1.77.8",
    "sass-resources-loader": "^2.0.3",
    "serve": "^14.1.2",
    "start-server-and-test": "^1.15.2",
    "storybook": "^8.2.4",
    "styled-jsx": "^5.1.1",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.4",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "yargs": "^17.6.2"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "prettier --config prettier.config.js --single-quote --write",
      "git add"
    ],
    "src/**/*.{ts,tsx}": [
      "prettier --config prettier.config.js --parser typescript --single-quote --write",
      "git add"
    ],
    "src/**/*.{scss,scs}": [
      "prettier --config prettier.config.js --parser scss --single-quote --write",
      "git add"
    ],
    "src/components/**/*.{ts,tsx}": [
      "npm run lint"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "overrides": {
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.10"
  },
  "browser": {
    "[module-name]": false,
    "crypto": false
  }
}

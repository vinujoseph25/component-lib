    "ag-grid-community": "32.1.0",
    "ag-grid-react": "32.1.0",
    "antd": "5.1.1",
    "babel-preset-react-app": "^10.0.1",
    "classnames": "^2.3.2",
    "codemirror": "^6.0.1",

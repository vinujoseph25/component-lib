    "country-flag-icons": "^1.5.5",
    "currency-codes": "^2.1.0",
    "dataobject-parser": "^1.2.22",
    "devtools-detect": "^4.0.1",
    "dom-inspector": "^1.2.5",
    "dompurify": "^3.1.7",
    "draft-js": "^0.11.7",
    "draftjs-to-html": "^0.9.1",
    "draftjs-utils": "^0.10.2",
    "dragula": "^3.7.3",

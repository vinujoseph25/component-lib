    "moment": "^2.24.0",
    "react": "18.2.0",
    "react-datepicker": "^2.14.1",
    "react-dom": "18.2.0",
    "react-router-dom": "^5.1.2",
    "react-select": "^5.7.0",
    "sass-loader": "^8.0.2",
    "style-loader": "^1.1.3"
  },
